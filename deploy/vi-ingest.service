[Unit]
Description=Приёмный сервис ВИ (ingest) для данных с внешнего хоста
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/ubuntu

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/monolit_vi_report
ExecStart=/opt/abacus-python/bin/python3 /home/ubuntu/monolit_vi_report/ingest_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
